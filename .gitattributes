# Keep repository text deterministic across Linux, macOS, and Windows. This is
# especially important because rustfmt.toml requires Unix newlines.
* text=auto eol=lf

# Native Windows command scripts conventionally use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Media fixtures are binary and must never be newline-normalized.
*.jpeg binary
*.jpg binary
*.mp3 binary
*.mp4 binary
*.png binary
*.wav binary

# Fuzzer seeds are byte-exact protocol inputs; several intentionally contain
# CR, invalid UTF-8, or NUL bytes and must not be normalized as text.
fuzz/corpus/**/seed-* binary
